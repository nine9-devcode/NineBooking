# ===== Database =====
# ค่านี้ตรงกับ docker-compose.yml — ถ้าใช้ `npm run db:up` ไม่ต้องแก้
DATABASE_URL="postgresql://ninebooking:ninebooking@localhost:5432/ninebooking?schema=public"

# ถ้าเครื่องมี PostgreSQL ตัวอื่นจองพอร์ต 5432 อยู่แล้ว ให้เปลี่ยนพอร์ตตรงนี้
# แล้วแก้เลขพอร์ตใน DATABASE_URL ข้างบนให้ตรงกันด้วย
# DB_PORT=5433

# ===== Auth =====
# สร้างค่าใหม่ด้วย: openssl rand -base64 32
NEXTAUTH_SECRET="เปลี่ยนค่านี้ให้ยาวอย่างน้อย 32 ตัวอักษรก่อนใช้งานจริง"
NEXTAUTH_URL="http://localhost:3000"

# ===== App =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== ไม่บังคับ =====
# ปลายทางอีเมลแจ้งเตือนผู้ดูแลระบบ (คั่นหลายอีเมลด้วยจุลภาค)
# อีเมลถูกเขียนเป็นไฟล์ .html ไว้ใน .dev-outbox/ ไม่ได้ส่งออกจริง
# ADMIN_EMAIL="admin@ninebooking.dev"

# bearer token สำหรับเรียก /api/cron จากตัวตั้งเวลาภายนอก
# ถ้าไม่ตั้ง จะเรียกได้เฉพาะผู้ดูแลระบบที่ล็อกอินอยู่
# CRON_SECRET="สุ่มค่ายาวอย่างน้อย 16 ตัวอักษร"
