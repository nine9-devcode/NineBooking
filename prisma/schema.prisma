// NineBooking — Prisma schema
// ระบบจองสินค้าออนไลน์ (Next.js + Prisma + PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
// Authentication
// ใช้ NextAuth แบบ Credentials + JWT session (ไม่มีตาราง Account/Session)
// ===================================================================

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  image    String?
  phone    String?
  password String? // bcrypt hash

  nickname           String? // ชื่อเล่น (บังคับกรอกตอน complete profile)
  residenceType      String? // single_house, condo, townhouse, apartment, other
  residenceTypeOther String? @db.Text

  role           UserRole @default(user)
  memberType     String?  @default("customer") // customer | contractor | dealer | other
  memberTypeNote String?  @db.Text

  // ที่อยู่
  address     String? // บ้านเลขที่ / ถนน / ซอย
  province    String?
  district    String?
  subDistrict String?
  postalCode  String?

  isProfileCompleted Boolean @default(false)

  orders               Order[]
  cartItems            CartItem[]
  contactIssues        ContactIssue[]
  orderNotifications   UserOrderNotification[]
  supportNotifications UserSupportNotification[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ลิงก์ตั้งรหัสผ่านใหม่ (แทนการยืนยันด้วย OTP/SMS)
// token ถูก hash ก่อนเก็บ — ค่าดิบอยู่ในลิงก์ที่ส่งให้ผู้ใช้เท่านั้น
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/// สิทธิ์ทั้งระบบวางอยู่บนฟิลด์นี้ จึงต้องเป็น enum ไม่ใช่ String อิสระ
///
/// superadmin คือ admin ที่มีสิทธิ์เพิ่ม ไม่ใช่คนละสาย — เข้าหลังบ้านได้ทุกอย่าง
/// ที่ admin เข้าได้ บวกเครื่องมือระบบที่ลบข้อมูลได้
/// เทียบสิทธิ์ผ่าน isAdminRole()/isSuperAdminRole() ใน src/lib/roles.ts เท่านั้น
enum UserRole {
  user
  admin
  superadmin
}

/// ตัวนับสำหรับจำกัดอัตราการเรียก ใช้ร่วมกันทุกจุดที่ต้องกันยิงรัว
///
/// key เป็นตัวกำหนดขอบเขตของการนับ เช่น
///   "login:email:a@b.c"  — กันเดารหัสผ่านของบัญชีหนึ่ง
///   "login:ip:1.2.3.4"   — กัน credential stuffing ที่ไล่ยิงหลายบัญชีจากที่เดียว
///   "register:ip:1.2.3.4"
///
/// ต้องมีทั้งสองแกน: นับต่อบัญชีอย่างเดียวไม่กันการสเปรย์รหัสเดียวข้ามพันบัญชี
/// และเปิดช่องให้ใครก็ได้ล็อกบัญชีคนอื่นทิ้งด้วยการกรอกผิดซ้ำๆ
model RateLimit {
  key String @id

  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?

  updatedAt DateTime @updatedAt

  @@index([blockedUntil])
}

/// ตัวนับเลขที่เอกสาร (ORD- / ISS- / QT-)
///
/// เดิมทั้งสามระบบใช้ count()+1 นอกทรานแซกชัน ซึ่งชนกันได้เมื่อมีคนกดพร้อมกัน
/// ตัวที่แพ้จะไปชน unique constraint แล้วพังทั้งคำสั่ง
/// upsert ที่ increment เป็น atomic ระดับ row จึงขอเลขได้ปลอดภัยในทรานแซกชันเดียวกัน
model DocumentCounter {
  scope  String // "ORDER" | "ISSUE" | "QUOTATION"
  period String // "20260807" (ต่อวัน) หรือ "2026" (ต่อปี)
  value  Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([scope, period])
}

// ===================================================================
// Catalog
// ===================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  sortOrder   Int     @default(1)

  // หมวดหมู่ซ้อนกันได้ (self-relation)
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("SubCategories")

  products Product[]
  isActive Boolean   @default(true)

  // จับคู่หมวดหมู่ (สองทาง)
  pairingsAsA CategoryPairing[] @relation("CategoryA")
  pairingsAsB CategoryPairing[] @relation("CategoryB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  subtitle    String?
  slug        String   @unique
  description String?  @db.Text // HTML จาก rich text editor
  image       String? // รูปหลัก
  images      String[] // แกลเลอรี

  datasheets Json? // [{ name, url, fileType, fileSize }, ...]
  viewCount  Int   @default(0)

  /// คอลัมน์ที่ Postgres คำนวณเองจาก name/subtitle/description (ดู migration)
  /// Prisma อ่านชนิดนี้ไม่ได้ จึงประกาศเป็น Unsupported และค้นผ่าน $queryRaw แทน
  searchVector Unsupported("tsvector")?

  categoryId String
  // Restrict โดยเจตนา: ลบหมวดที่ยังมีสินค้าอยู่ไม่ได้ ต้องย้ายสินค้าออกก่อน
  // (Category.parent เป็น Cascade เพราะหมวดย่อยไม่มีความหมายถ้าไม่มีหมวดแม่)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // จับคู่สินค้าเฉพาะเจาะจง (สองทาง) — ถ้ามี จะไม่ใช้การจับคู่ระดับหมวดหมู่
  exclusivePairingsA   ExclusivePairing[] @relation("ExclusiveProductA")
  exclusivePairingsB   ExclusivePairing[] @relation("ExclusiveProductB")
  showCategoryPairings Boolean            @default(false)

  orderItems       OrderItem[] @relation("OrderProduct")
  pairedOrderItems OrderItem[] @relation("PairedOrderProduct")
  cartItems        CartItem[]
  pairedInCarts    CartItem[]  @relation("PairedCartProduct")

  productViews         ProductView[]
  productViewSummaries ProductViewSummary[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([viewCount])
  @@index([searchVector], type: Gin)
}

// การเข้าชมรายครั้ง — cron สรุปลง ProductViewSummary แล้วลบทิ้ง
model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  viewedAt  DateTime @default(now())

  processed Boolean @default(false)

  @@index([productId])
  @@index([viewedAt])
  @@index([processed])
  @@index([productId, userId])
}

// ยอดเข้าชมสรุปรายวัน (เก็บถาวร)
model ProductViewSummary {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  viewCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
  @@index([date])
}

model CategoryPairing {
  id String @id @default(cuid())

  categoryAId String
  categoryA   Category @relation("CategoryA", fields: [categoryAId], references: [id], onDelete: Cascade)

  categoryBId String
  categoryB   Category @relation("CategoryB", fields: [categoryBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryAId, categoryBId])
  @@index([categoryAId])
  @@index([categoryBId])
}

// เก็บทางเดียว (A-B) แล้ว query สองทาง — unique กันเพิ่ม B-A ซ้ำ
model ExclusivePairing {
  id String @id @default(cuid())

  productAId String
  productA   Product @relation("ExclusiveProductA", fields: [productAId], references: [id], onDelete: Cascade)

  productBId String
  productB   Product @relation("ExclusiveProductB", fields: [productBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productAId, productBId])
  @@index([productAId])
  @@index([productBId])
}

/// บันทึกว่าใครทำอะไรกับข้อมูลไหนเมื่อไหร่
///
/// ก่อนหน้านี้ระบบไม่มีร่องรอยเลยว่าใครเปลี่ยนสถานะคำสั่งจอง ใครลบสินค้า
/// หรือใครตั้งใครเป็นแอดมิน — ฟิลด์เดียวที่บอกตัวผู้กระทำคือ Quotation.createdBy
/// ซึ่งเป็น String ที่ไม่มี FK ด้วยซ้ำ
///
/// before/after เก็บเป็น Json เพื่อไม่ต้องผูกกับรูปร่างของแต่ละตาราง
/// เก็บเฉพาะฟิลด์ที่เปลี่ยนจริง ไม่ใช่ทั้งแถว
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// รูปแบบ "<entity>.<action>" เช่น "order.status_changed", "user.role_changed"
  action     String
  entityType String
  entityId   String

  /// ชื่อที่คนอ่านออก เช่น "ORD-20260807-001" หรือชื่อสินค้า
  ///
  /// entityId เป็น cuid ภายในซึ่งไม่มีใครจำได้ คำถามที่คนถามจริงคือ
  /// "ใครแตะ ORD-20260807-001 บ้าง" จึงต้องเก็บเลขที่เอกสารไว้ตอนบันทึกด้วย
  /// (เก็บ ณ ตอนนั้น ไม่ใช่ join ทีหลัง เพราะของที่ถูกลบไปแล้ว join ไม่เจอ)
  entityLabel String?

  before Json?
  after  Json?
  ip     String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityLabel])
  @@index([createdAt])
}

// ===================================================================
// Cart & Orders
// ===================================================================

enum CancelledBy {
  CUSTOMER
  ADMIN
}

enum SupportNotificationType {
  RESPONSE
  IN_PROGRESS
  CLOSED
}

model CartItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  pairedProductId String?
  pairedProduct   Product? @relation("PairedCartProduct", fields: [pairedProductId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, pairedProductId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // ORD-2026-0001

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  orderItems        OrderItem[]
  notifications     OrderNotification[]
  userNotifications UserOrderNotification[]
  quotations        Quotation[]

  // ข้อมูลผู้จอง (snapshot ณ เวลาจอง)
  customerName     String
  customerEmail    String
  customerPhone    String
  customerNickname String?

  // ที่อยู่จัดส่ง (snapshot)
  shippingAddress       String? @db.Text
  shippingProvince      String?
  shippingDistrict      String?
  shippingSubDistrict   String?
  shippingPostalCode    String?
  shippingResidenceType String?

  customerNote String? @db.Text
  adminNote    String? @db.Text

  status       OrderStatus  @default(PENDING)
  cancelledBy  CancelledBy?
  cancelledAt  DateTime?
  cancelReason String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  // หน้า "คำสั่งจองของฉัน" กรองด้วย userId + status แล้วเรียงตาม createdAt เสมอ
  @@index([userId, status])
  @@index([userId, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // SetNull ไม่ใช่ Restrict: แถวนี้ snapshot ชื่อและรูปไว้แล้ว (productName/productImage)
  // ประวัติจึงยังอ่านออกแม้สินค้าจะถูกลบ — ของเดิมทำให้ลบสินค้าไม่ได้ตลอดกาล
  // ถ้าเคยมีคนสั่ง
  productId String?
  product   Product? @relation("OrderProduct", fields: [productId], references: [id], onDelete: SetNull)

  pairedProductId String?
  pairedProduct   Product? @relation("PairedOrderProduct", fields: [pairedProductId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  // snapshot กันสินค้าถูกแก้/ลบภายหลัง
  productName        String
  productImage       String?
  pairedProductName  String?
  pairedProductImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([pairedProductId])
}

enum OrderStatus {
  PENDING // รอดำเนินการ
  CONFIRMED // ยืนยันแล้ว
  COMPLETED // เสร็จสิ้น
  CANCELLED // ยกเลิก
}

// ===================================================================
// Quotations (ใบเสนอราคา)
// ===================================================================

model Quotation {
  id              String @id @default(cuid())
  quotationNumber String @unique // QT-2026-0001

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  items QuotationItem[]

  subtotal    Decimal @db.Decimal(12, 2) // ก่อน VAT
  includeVat  Boolean @default(true)
  vatPercent  Decimal @default(7) @db.Decimal(5, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2) // หลัง VAT

  validDays  Int      @default(15)
  validUntil DateTime
  notes      String?  @db.Text
  pdfNotes   String?  @db.Text // null = ใช้ template, "" = ไม่แสดง, ข้อความ = กำหนดเอง

  status QuotationStatus @default(DRAFT)

  createdBy     String?
  createdByName String?

  // การตอบกลับของลูกค้า — ก่อนหน้านี้ ACCEPTED/REJECTED ตั้งได้แค่แอดมิน
  // ลูกค้าจึงไม่มีทางกดยอมรับใบเสนอราคาของตัวเองได้เลย
  respondedAt   DateTime?
  respondedNote String?   @db.Text
  sentAt        DateTime?

  // ทำเวอร์ชัน: QT-2026-0001 → V2, V3 โดยใช้ baseNumber เดียวกัน
  version    Int     @default(1)
  baseNumber String  @default("")
  isLatest   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([quotationNumber])
  @@index([baseNumber, version])
  @@index([isLatest])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId    String?
  productName  String
  productImage String?

  isPairedProduct Boolean @default(false)
  pairedWithIndex Int?

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  amount    Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([sortOrder])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ===================================================================
// Support (แจ้งปัญหา)
// ===================================================================

model ContactIssue {
  id          String @id @default(cuid())
  issueNumber String @unique // ISS-2026-0001

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  subject     String
  category    IssueCategory @default(OTHER)
  description String        @db.Text
  imageUrls   String[] // path ใต้ /uploads (สูงสุด 3 รูป)

  status        IssueStatus @default(PENDING)
  adminResponse String?     @db.Text
  respondedAt   DateTime?

  notifications     IssueNotification[]
  userNotifications UserSupportNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum IssueCategory {
  BOOKING // การจอง
  PAYMENT // การชำระเงิน
  USAGE_ISSUE // ปัญหาการใช้งาน
  ACCOUNT // บัญชีผู้ใช้
  OTHER // อื่นๆ
}

enum IssueStatus {
  PENDING // รอดำเนินการ
  IN_PROGRESS // กำลังดำเนินการ
  CLOSED // ปิดเรื่อง
}

// ===================================================================
// Notifications
// ===================================================================

// กระดิ่งฝั่ง admin — มีออเดอร์ใหม่เข้ามา
model OrderNotification {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderNumber      String
  customerName     String
  customerNickname String
  totalItems       Int

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
  @@index([orderId])
}

// กระดิ่งฝั่ง admin — มีเรื่องแจ้งปัญหาใหม่
model IssueNotification {
  id      String       @id @default(cuid())
  issueId String
  issue   ContactIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  issueNumber  String
  userName     String
  userNickname String?
  subject      String

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
  @@index([issueId])
}

// กระดิ่งฝั่งลูกค้า — สถานะออเดอร์เปลี่ยน
model UserOrderNotification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderNumber String
  oldStatus   OrderStatus
  newStatus   OrderStatus

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([orderId])
}

// กระดิ่งฝั่งลูกค้า — เรื่องแจ้งปัญหามีความคืบหน้า
model UserSupportNotification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issueId String
  issue   ContactIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  issueNumber      String
  notificationType SupportNotificationType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([issueId])
}

// ===================================================================
// Settings (แก้ได้จากหน้า admin)
// ===================================================================

model SystemSettings {
  id              String  @id @default(cuid())
  showHomePage    Boolean @default(true) // false = ปิดเว็บชั่วคราว
  maintenanceMode Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoSettings {
  id              String  @id @default(cuid())
  siteTitle       String  @default("NineBooking")
  siteDescription String? @db.Text
  ogImage         String?

  googleAnalyticsId String? // G-XXXXXXXXXX

  facebookUrl String?
  lineUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ข้อมูลบริษัทที่พิมพ์ลงหัวใบเสนอราคา PDF
model QuotationSettings {
  id            String @id @default(cuid())
  companyNameTh String @default("บริษัท ไนน์บุ๊คกิ้ง จำกัด (สำนักงานใหญ่)")
  companyNameEn String @default("NINEBOOKING CO., LTD.")
  address       String @default("99/9 ถนนตัวอย่าง แขวงตัวอย่าง เขตตัวอย่าง กรุงเทพฯ 10000")
  taxId         String @default("0000000000000")
  phone         String @default("02-000-0000")
  website       String @default("ninebooking.example")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

